# Copie para .env e substitua pelos dados do seu serviço PostgreSQL Aiven.
# Nunca use credenciais reais neste arquivo de exemplo.
DB_HOST=seu-host-postgresql.aivencloud.com
DB_PORT=porta_do_postgresql
DB_NAME=nome_do_banco
DB_USER=usuario_somente_leitura
DB_PASSWORD=SUBSTITUA_LOCALMENTE
DB_SSLMODE=require

# Configuração do dashboard. O modo postgres exige PostgreSQL e desativa o fallback.
APP_DATA_MODE=auto
# Para verify-ca ou verify-full, use o caminho de um arquivo de CA local.
# DB_SSLROOTCERT=/caminho/local/ca.pem
# No Community Cloud, use DB_SSL_CA_PEM em Secrets ou DB_SSLROOTCERT em ambiente gerenciado.
